    {x86_wrssd, 140486}, // __builtin_ia32_wrssd
    {x86_wrssq, 140492}, // __builtin_ia32_wrssq
    {x86_wrussd, 140498}, // __builtin_ia32_wrussd
    {x86_wrussq, 140505}, // __builtin_ia32_wrussq
